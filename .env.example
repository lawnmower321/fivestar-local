# ReplyDesk — copy to .env.local and fill in. NEVER commit .env.local.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # server-only, bypasses RLS, data access
SUPABASE_PUBLISHABLE_KEY=sb_publishable_... # server-only here (browser never talks to Supabase)
OPENROUTER_API_KEY=sk-or-v1-...
